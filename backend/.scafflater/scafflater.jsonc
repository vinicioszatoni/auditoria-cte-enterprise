                      }
                    }
                  ]
                }
              }
            },
            "loglevel": "error",
            "mq": {
              "deploymentMode": "CLUSTER_MULTI_AZ",
              "engineType": "RabbitMQ",
              "hostInstanceType": "mq.m7g.medium",
              "maintenanceWindowStartTime": {
