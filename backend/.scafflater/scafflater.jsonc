                        "nodejs": "arn:aws:lambda:eu-south-2:184161586896:layer:opentelemetry-nodejs-0_23_0:1",
                        "python": "arn:aws:lambda:eu-south-2:184161586896:layer:opentelemetry-python-0_21_0:1"
                      }
                    }
                  ]
                },
                "us-east-1": {
                  "lambdaInsights": [
                    {
                      "type": "architecture",
                      "architectures": {
                        "x86_64": "arn:aws:lambda:us-east-1:580247275435:layer:LambdaInsightsExtension:64",
                        "arm64": "arn:aws:lambda:us-east-1:580247275435:layer:LambdaInsightsExtension-Arm64:31"
                      }
                    }
                  ],
                  "otel": [
                    {
                      "type": "language",
                      "languages": {
                        "java": "arn:aws:lambda:us-east-1:184161586896:layer:opentelemetry-javaagent-0_21_0:1",
                        "nodejs": "arn:aws:lambda:us-east-1:184161586896:layer:opentelemetry-nodejs-0_23_0:1",
                        "python": "arn:aws:lambda:us-east-1:184161586896:layer:opentelemetry-python-0_21_0:1"
                      }
                    }
                  ]
                },
                "sa-east-1": {
                  "lambdaInsights": [
                    {
                      "type": "architecture",
                      "architectures": {
                        "x86_64": "arn:aws:lambda:sa-east-1:580247275435:layer:LambdaInsightsExtension:63",
                        "arm64": "arn:aws:lambda:sa-east-1:580247275435:layer:LambdaInsightsExtension-Arm64:29"
                      }
                    }
                  ],
                  "otel": [
                    {
                      "type": "language",
                      "languages": {
                        "java": "arn:aws:lambda:sa-east-1:184161586896:layer:opentelemetry-javaagent-0_21_0:1",
                        "nodejs": "arn:aws:lambda:sa-east-1:184161586896:layer:opentelemetry-nodejs-0_23_0:1",
                        "python": "arn:aws:lambda:sa-east-1:184161586896:layer:opentelemetry-python-0_21_0:1"
                      }
                    }
                  ]
                },
                "us-east-2": {
                  "lambdaInsights": [
                    {
                      "type": "architecture",
                      "architectures": {
                        "x86_64": "arn:aws:lambda:us-east-2:580247275435:layer:LambdaInsightsExtension:64",
                        "arm64": "arn:aws:lambda:us-east-2:580247275435:layer:LambdaInsightsExtension-Arm64:33"
                      }
                    }
                  ],
                  "otel": [
                    {
                      "type": "language",
                      "languages": {
                        "java": "arn:aws:lambda:us-east-2:184161586896:layer:opentelemetry-javaagent-0_21_0:1",
                        "nodejs": "arn:aws:lambda:us-east-2:184161586896:layer:opentelemetry-nodejs-0_23_0:1",
