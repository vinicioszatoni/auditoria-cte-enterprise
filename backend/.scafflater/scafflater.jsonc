        "name": "aws-plataforma-logistica-prd",
        "stage": "prd",
        "parameters": {
          "needs": [
            "cd_hml"
          ],
          "if": "${{ success() && github.ref == 'refs/heads/main' }}"
        },
        "infraDefaults": {
          "metadata": {
            "namespace": "default",
            "annotations": {
              "backstage.io/managed-by-location": "url:https://github.com/grupoboticario/alquimia-dev-platform/tree/main/defaults/infra/aws/prd.yaml",
              "backstage.io/managed-by-origin-location": "url:https://github.com/grupoboticario/alquimia-dev-platform/blob/main/defaults/infra/location.yaml",
              "backstage.io/view-url": "https://github.com/grupoboticario/alquimia-dev-platform/tree/main/defaults/infra/aws/prd.yaml",
              "backstage.io/edit-url": "https://github.com/grupoboticario/alquimia-dev-platform/edit/main/defaults/infra/aws/prd.yaml",
              "backstage.io/source-location": "url:https://github.com/grupoboticario/alquimia-dev-platform/tree/main/defaults/infra/aws/"
            },
            "name": "aws-prd",
            "description": "Configurações padrão das contas AWS em ambientes produtivos",
            "uid": "d454357d-aea6-475e-8dfb-08dfdcfd6f8d",
            "etag": "1f90fd4f6f8ef72a8cab714f644b032108296a91"
          },
          "apiVersion": "alquimia.gb.tech/v1alpha1",
          "kind": "InfraDefaults",
          "spec": {
            "apiGateway": {
              "endpoint": {
                "accessMode": "strict",
                "securityPolicy": "SecurityPolicy_TLS13_2025_EDGE"
              }
            },
            "app": {
              "dnsPolicy": "ClusterFirst",
              "image": {
                "pullPolicy": "IfNotPresent"
              },
              "ingress": {
                "scope": "private"
              },
              "service": {
                "protocol": "TCP",
                "targetPort": "http",
                "type": "NodePort"
              },
              "strategy": "RollingUpdate",
              "eventhub": {
                "producerBrokers": "eventhub-0-pub.grupoboticario.digital:9096,eventhub-1-pub.grupoboticario.digital:9096,eventhub-2-pub.grupoboticario.digital:9096",
                "consumerBrokers": "eventhub-0-sub.grupoboticario.digital:9096,eventhub-1-sub.grupoboticario.digital:9096,eventhub-2-sub.grupoboticario.digital:9096",
                "schemaRegistryUrl": "https://api-private.grupoboticario.com.br/global/v1/event-hub/schema-registry"
              }
            },
            "cache": {
              "dbSubnetGroupName": "crossplane-subnet-group",
              "logDeliveryConfiguration": {
                "engine": {
                  "destinationType": "cloudwatch-logs",
                  "logFormat": "json",
                  "logType": "engine-log"
                },
                "slow": {
                  "destinationType": "cloudwatch-logs",
                  "logFormat": "json",
                  "logType": "slow-log"
                }
              },
              "preferredMaintenanceWindow": "mon:02:40-mon:03:40",
              "snapshotWindow": "01:00-02:00"
            },
            "cloudfront": {
              "cachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
              "httpVersion": "http2and3",
              "originRequestPolicyId": "88a5eaf4-2fd4-4709-b370-b4c650ea3fcf",
              "priceClass": "PriceClass_All",
              "responseHeadersPolicyId": "eaab4381-ed33-4a86-88ca-d9558dc6cd63"
            },
            "docdb": {
              "dbSubnetGroupName": "crossplane-subnet-group"
            },
            "eventhub": {
              "kafkaBootstrapServers": "eventhub-0-sub.grupoboticario.digital:9096,eventhub-1-sub.grupoboticario.digital:9096,eventhub-2-sub.grupoboticario.digital:9096",
              "schemaRegistryUrl": "https://api-private.grupoboticario.digital/global/v1/event-hub/schema-registry"
            },
            "lambdaLayers": {
              "regions": {
                "eu-south-2": {
                  "lambdaInsights": [
                    {
                      "type": "architecture",
                      "architectures": {
                        "x86_64": "arn:aws:lambda:eu-south-2:352183217350:layer:LambdaInsightsExtension:40",
                        "arm64": "arn:aws:lambda:eu-south-2:352183217350:layer:LambdaInsightsExtension-Arm64:18"
                      }
                    }
                  ],
                  "otel": [
                    {
                      "type": "language",
                      "languages": {
