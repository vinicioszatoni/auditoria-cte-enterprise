            "region": "us-east-1",
            "charts": {
              "app-v1": {
                "name": "gb-app-v1",
                "revision": "1.19.1"
              },
              "infra-v1": {
                "name": "gb-infra-v1",
                "revision": "1.27.8"
              },
              "infra-v2": {
                "name": "gb-infra-v2",
                "revision": "2.33.5"
              }
            },
