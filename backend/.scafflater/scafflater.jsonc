          "domain": "plataforma-logistica",
          "crossplane": {
            "provider": "aws",
            "version": "v0.42.0"
          },
          "aws": {
            "accountId": "647051202209",
            "kmsCmkArn": "arn:aws:kms:us-east-1:154548531805:key/mrk-410b05e174d24c4c9fef6a83b0d7fb52",
            "waf": {
              "backend": {
                "arn": "arn:aws:wafv2:us-east-1:647051202209:regional/webacl/acl-backend/4e51bf27-43d4-40f2-9d59-4606d5b41e29"
              },
              "frontend": {
                "arn": "arn:aws:wafv2:us-east-1:647051202209:global/webacl/acl-frontend/2d9e045c-bdec-442d-bb71-b67d67ae3a79"
              },
              "webAclFrontendDefaultArn": "arn:aws:wafv2:us-east-1:647051202209:global/webacl/acl-frontend/2d9e045c-bdec-442d-bb71-b67d67ae3a79",
              "webAclBackendDefaultArn": "arn:aws:wafv2:us-east-1:647051202209:regional/webacl/acl-backend/4e51bf27-43d4-40f2-9d59-4606d5b41e29"
            },
            "eks": {
              "clusters": {
                "default": {
                  "name": "eks-pl-prd",
                  "oidc": "D2D0069511DA35FC99435694C724C0F4"
                }
              }
            },
            "ingress": {
              "defaultGroup": "disabled"
            },
            "features": {
              "hybridAutoscaling": {
                "mode": "hpa-cpu-vpa-memory",
                "maxChange": "30%",
                "vpa": {
                  "updateMode": "Off"
                }
