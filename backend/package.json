{
  "name": "auditoria-cte-backend",
  "version": "1.0.0",
  "description": "API Core para Sistema de Fretes e Auditoria Logística",
  "main": "server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run cp:sslbundle",
    "start:dev": "tsc -p tsconfig.json && tsc -w & node --watch dist/src/index.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prettier": "prettier src/* --check",
    "prettier:fix": "prettier src/* --write",
    "patch": "npm version patch -m \"release: version %s\" && git push --tags && git push",
    "test": "NODE_ENV=test node --experimental-vm-modules ./node_modules/jest/bin/jest.js --detectOpenHandles --randomize --forceExit --coverage --maxWorkers=50% --silent",
    "cp:sslbundle": "npx cpx \"./src/services/*.pem\" ./dist/src/services",
    "apply-db-migrations": "npx sequelize-cli db:migrate",
    "apply-db-migrations-seeds": "npx sequelize-cli db:seed:all"
  },
  "keywords": [],
  "author": "Grupo Boticário - Transportes GB | vinicios.cordeiro@grupoboticario.com.br",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/swagger": "^9.9.2",
    "@google-cloud/bigquery": "^9.3.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dnscache": "^1.0.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^7.1.4",
    "fastify": "^5.12.5",
    "fs-extra": "^11.1.4",
    "googleapis": "^186.0.0",
    "helmet": "^7.1.0",
    "pg": "^8.17.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "sequelize-cli": "^6.6.5",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
